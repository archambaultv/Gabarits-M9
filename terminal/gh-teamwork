def pr_lines(slug, pr, args):
    """Lignes ± d'une PR, sans les fichiers générés. Au-delà de 100 fichiers, on passe par REST."""
    files = pr["files"]["nodes"]
    if pr["files"]["totalCount"] > len(files):
        files = rest_lines(f"repos/{slug}/pulls/{pr['number']}/files?per_page=100")
        files = [{"path": f["filename"], "additions": f["additions"], "deletions": f["deletions"]} for f in files]
    return sum(f["additions"] + f["deletions"] for f in files
               if not gt.is_excluded(f["path"], args.exclude_file, not args.no_default_excludes))


def read_prs(owner, name, args, identities):
    slug = f"{owner}/{name}"
    prs = []
    for raw in graphql_nodes(PR_QUERY, ["repository", "pullRequests"], owner=owner, name=name):
        commits = []
        for node in raw["commits"]["nodes"]:
            c = node["commit"]
            identities.add_commit(c["author"])
            commits.append({"at": parse_time(c["committedDate"]), "merge": c["parents"]["totalCount"] > 1})
        last = raw["lastCommit"]["nodes"]
        rollup = last[0]["commit"]["statusCheckRollup"] if last else None
        prs.append({
            "slug": slug,
            "number": raw["number"],
            "title": raw["title"],
            "url": raw["url"],
            "state": raw["state"],
            "created": parse_time(raw["createdAt"]),
            "merged": parse_time(raw["mergedAt"]),
            "base": raw["baseRefName"],
            "head": raw["headRefName"],
            "author": raw["author"],
            "merged_by": raw["mergedBy"],
            "merge_oid": (raw["mergeCommit"] or {}).get("oid"),
            "linked": bool(raw["closingIssuesReferences"]["totalCount"]
                           or TICKET.search(raw["title"] or "") or TICKET.search(raw["body"] or "")
                           or TICKET_BRANCH.search(raw["headRefName"] or "")),
            "lines": pr_lines(slug, raw, args),
            "reviews": [{"author": r["author"], "state": r["state"], "at": parse_time(r["submittedAt"]),
                         "words": words(r["body"]) + sum(words(c["body"]) for c in r["comments"]["nodes"])}
                        for r in raw["reviews"]["nodes"]],
            "comments": [{"author": c["author"], "words": words(c["body"])} for c in raw["comments"]["nodes"]],
            "commits": commits,
            "ci": (rollup or {}).get("state"),
        })
    return prs


def read_pushes(repo, owner, name, protected):
    """Mises à jour des branches protégées, d'après l'API activity, ou None si elle est inaccessible."""
    try:
        events = rest_lines(f"repos/{owner}/{name}/activity?per_page=100")
    except GhError as e:
        print(f"{owner}/{name} : activité inaccessible ({e}), règles push et force sans objet.", file=sys.stderr)
        return None, None
    pushes = []
    first_day = None
    for e in events:
        if e["activity_type"] not in ("push", "force_push"):
            continue
        at = parse_time(e["timestamp"])
        first_day = min(first_day or at.date(), at.date())
        branch = e["ref"].removeprefix("refs/heads/")
        if branch not in protected:
            continue
        push = {"slug": f"{owner}/{name}", "at": at, "branch": branch, "force": e["activity_type"] == "force_push",
                "actor": e["actor"], "after": e["after"], "files": None, "commits": None, "subject": ""}
        before = e["before"]
        if before and not ZERO_SHA.fullmatch(before):
            files = run_git(repo, "diff", "--name-only", before, e["after"])
            count = run_git(repo, "rev-list", "--count", f"{before}..{e['after']}")
            if files is not None:
                push["files"] = [f for f in files.splitlines() if f]
            if count is not None:
                push["commits"] = int(count)
        push["subject"] = (run_git(repo, "log", "-1", "--format=%s", e["after"]) or "").strip()
        pushes.append(push)
    for push in pushes:
        push["setup"] = push["at"].date() == first_day
        push["docs"] = bool(push["files"]) and all(is_doc(f) for f in push["files"])
    return pushes, first_day


def read_protection(owner, name, branch):
    """True si la branche est protégée (protection classique ou ruleset), None si inconnu."""
    try:
        protected = gh("api", f"repos/{owner}/{name}/branches/{branch}", "--jq", ".protected").strip() == "true"
        rules = int(gh("api", f"repos/{owner}/{name}/rules/branches/{branch}", "--jq", "length").strip() or 0)
        return protected or rules > 0
    except (GhError, ValueError):
        return None


