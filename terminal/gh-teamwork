# Identités : login GitHub → courriels des commits → .mailmap → élève
# ---------------------------------------------------------------------------

class Identities:
    def __init__(self, roster, exclude_patterns):
        self.roster = roster
        self.exclude = exclude_patterns
        self.contacts = collections.defaultdict(collections.Counter)  # login → {« nom <courriel> »: n}
        self.students = {}  # login (minuscules) → clé d'élève
        self.names = {}  # clé d'élève → nom affiché
        self.unknown = collections.Counter()  # login non identifié → nombre d'actions (PR, revues, pushes)

    def add_commit(self, author):
        login = ((author or {}).get("user") or {}).get("login")
        if login and author.get("email"):
            self.contacts[login.lower()][f"{author['name']} <{author['email']}>"] += 1

    def resolve(self, repo, config, mailmap_files, logins):
        """Relie chaque login à un élève : noreply du .mailmap, sinon courriel le plus fréquent."""
        noreply = {}
        for path in mailmap_files:
            for line in path.read_text().splitlines():
                contacts = re.findall(r"([^<>]*)<([^<>]*)>", line.split("#", 1)[0])
                if not contacts:
                    continue
                canon_name, canon_email = (part.strip() for part in contacts[0])
                for _, email in contacts:
                    if m := NOREPLY.fullmatch(email.strip()):
                        noreply[m.group(1).lower()] = (canon_name, canon_email)

        all_contacts = sorted({c for counter in self.contacts.values() for c in counter})
        mapped = gt.map_contacts(repo, all_contacts, config)
        names = collections.defaultdict(collections.Counter)
        for login in sorted(logins):
            candidates = collections.Counter()
            if login in noreply:
                name, email = noreply[login]
                candidates[(name, email.lower())] = 1
            else:
                for contact, n in self.contacts[login].items():
                    if contact in mapped:
                        name, email = mapped[contact][:2]
                        candidates[(name, email.lower())] += n
            if self.roster is not None:
                in_roster = collections.Counter({k: n for k, n in candidates.items() if k[1] in self.roster})
                candidates = in_roster or collections.Counter()
            if candidates:
                (name, key), _ = candidates.most_common(1)[0]
            elif self.roster is None:
                name, key = login, f"@{login}"
            else:
                continue  # Non identifié
            self.students[login] = key
            names[key][name or login] += 1
        for key, counter in names.items():
            self.names[key] = self.roster[key] if self.roster is not None else counter.most_common(1)[0][0]
        for key, name in (self.roster or {}).items():
            self.names.setdefault(key, name)

    def key(self, actor):
        """Clé de l'élève, ou None pour un bot, un compte supprimé ou un login non identifié."""
        if not actor or not actor.get("login") or is_bot(actor, self.exclude):
            return None
        return self.students.get(actor["login"].lower())


