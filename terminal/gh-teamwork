def in_period(moment, since, until):
    return moment is not None and (since is None or moment >= since) and (until is None or moment < until)


def other_humans(pr, author_key, ids, items):
    """Revues ou commentaires d'une personne autre que l'auteur (bots exclus)."""
    out = []
    for item in items:
        actor = item["author"]
        if not actor or is_bot(actor, ids.exclude):
            continue
        key = ids.key(actor)
        login = actor["login"].lower()
        if (key or f"?{login}") != author_key and login != (pr["author"] or {}).get("login", "").lower():
            out.append((key, item))
    return out


def analyse(prs, pushes, protected, ids, args):
    since, until = args.since_dt, args.until_dt
    students = {key: {"name": name, "pr": 0, "unreviewed": 0, "push": 0, "force": 0, "reviews": 0, "superficial": 0}
                for key, name in ids.names.items()}
    merged = [p for p in prs if p["state"] == "MERGED" and in_period(p["merged"], since, until)]
    delivery = [p for p in merged if p["head"] in protected and p["base"] in protected]
    by_bot = [p for p in merged if p not in delivery and is_bot(p["author"], ids.exclude)]
    regular, by_unknown = [], []
    for p in merged:
        if p in delivery or p in by_bot:
            continue
        p["author_key"] = ids.key(p["author"])
        if p["author_key"] is None:
            by_unknown.append(p)
            continue
        p["merger_key"] = ids.key(p["merged_by"])
        regular.append(p)
        students[p["author_key"]]["pr"] += 1

    rows = {r: [] for r in RULES}
    stats = {"merged": merged, "delivery": delivery, "by_bot": by_bot, "regular": regular, "by_unknown": by_unknown,
             "unmerged": [p for p in prs if p["state"] != "MERGED" and in_period(p["created"], since, until)]}

    reviewers = collections.Counter()
    matrix = collections.Counter()
    iterated = 0
    reviewed, reviewed_big, approved = [], [], []
    for p in regular:
        reviews = other_humans(p, p["author_key"], ids, p["reviews"])
        comments = [(k, c) for k, c in other_humans(p, p["author_key"], ids, p["comments"]) if c["words"]]
        approvals = [r for _, r in reviews if r["state"] == "APPROVED"]
        commits = [c["at"] for c in p["commits"] if not c["merge"] and c["at"]]
        reviewer_keys = {k for k, _ in reviews} | {k for k, _ in comments}
        for key in reviewer_keys - {None}:
            students[key]["reviews"] += 1
            reviewers[key] += 1
            matrix[(p["author_key"], key)] += 1

        if not reviewer_keys:
            # Personne d'autre n'a laissé de trace : ni revue, ni commentaire
            rows["revision"].append(p)
            students[p["author_key"]]["unreviewed"] += 1
        else:
            reviewed.append(p)
            if not approvals:
                rows["approve"].append(p)
            said = sum(r["words"] for _, r in reviews) + sum(c["words"] for _, c in comments)
            if p["lines"] >= REVIEW_MIN_LINES:
                reviewed_big.append(p)
                if said < p["lines"] / WORDS_PER_LINES:
                    p["said"] = said
                    rows["revue"].append(p)
                    for key in reviewer_keys - {None}:
                        students[key]["superficial"] += 1
            dated = [r["at"] for _, r in reviews if r["at"]]
            if any(r["state"] == "CHANGES_REQUESTED" for _, r in reviews) or (
                    dated and any(c > min(dated) for c in commits)):
                iterated += 1
        if approvals:
            approved.append(p)
            last_approval = max(r["at"] for r in approvals if r["at"])
            if commits and max(commits) > last_approval:
                rows["perimee"].append(p)
        if p["ci"] in ("FAILURE", "ERROR"):
            rows["ci"].append(p)
        if not p["linked"]:
            rows["ticket"].append(p)
    stats.update(reviewers=reviewers, matrix=matrix, iterated=iterated, reviewed=len(reviewed),
                 reviewed_big=len(reviewed_big), approved=len(approved),
                 with_ci=sum(1 for p in regular if p["ci"]))

    if pushes is not None:
        stats["setup"] = 0
        for push in pushes:
            if not in_period(push["at"], since, until) or push["after"] in args.merge_oids:
                continue
            key = ids.key(push["actor"])
            if key is None and (is_bot(push["actor"], ids.exclude) or not push["actor"]):
                continue
            if push["setup"]:
                stats["setup"] += 1
                continue
            push["key"] = key
            rows["push"].append(push)
            if push["force"]:
                rows["force"].append(push)
            if key is not None:
                students[key]["push"] += 1
                students[key]["force"] += push["force"]
    return students, rows, stats


