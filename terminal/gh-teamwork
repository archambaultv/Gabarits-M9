def load_git_teamwork():
    """git-teamwork est un script sans extension : on le charge comme module."""
    path = Path(__file__).resolve().with_name("git-teamwork")
    loader = SourceFileLoader("git_teamwork", str(path))
    module = module_from_spec(spec_from_loader("git_teamwork", loader))
    loader.exec_module(module)
    return module


gt = load_git_teamwork()

RULES = ("push", "force", "revision", "ci", "approve", "revue", "perimee", "concentration", "ticket")
EXTRA_PROTECTED = ("dev", "develop")

# Une PR plus petite n'exige aucun mot de revue ; au-delà, un mot par WORDS_PER_LINES lignes
REVIEW_MIN_LINES = 50
WORDS_PER_LINES = 50
CONCENTRATION = 0.6
CONCENTRATION_MIN_REVIEWS = 5

DOC_DIRS = ("docs/", "doc/")
DOC_SUFFIXES = (".md", ".mdx", ".txt", ".rst", ".png", ".jpg", ".jpeg", ".gif", ".svg", ".pdf", ".webp")

NOREPLY = re.compile(r"(?:\d+\+)?([^@\s]+)@users\.noreply\.github\.com", re.IGNORECASE)
GITHUB_REMOTE = re.compile(r"github\.com[:/]([^/]+)/([^/]+?)(?:\.git)?/?$")
TICKET = re.compile(r"#\d+")
TICKET_BRANCH = re.compile(r"(?:^|/)#?\d+(?:[-_]|$)")
ZERO_SHA = re.compile(r"0+")

COLORS = {"✗": "31", "⚠": "33", "✓": "32"}

PR_QUERY = """
query($owner: String!, $name: String!, $cursor: String) {
  repository(owner: $owner, name: $name) {
    pullRequests(first: 20, after: $cursor, orderBy: {field: CREATED_AT, direction: ASC}) {
