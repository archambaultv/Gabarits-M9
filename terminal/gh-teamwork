def plural(n, word, suffix="s"):
    return f"{n} {word}{suffix if n > 1 else ''}"


def ratio(part, whole):
    return f"{part}/{whole} ({part * 100 / whole:.0f} %)" if whole else "0"


def evaluate(students, rows, stats, issues, n, args):
    """Une ligne par règle : (symbole, libellé, constat), dans l'ordre de gravité."""
    regular = stats["regular"]
    out = []
    if not regular:
        out.append(("✗", "Aucune PR fusionnée", "le travail arrive autrement que par PR"))

    def na(reason):
        return "–", reason

    def rule(name, label, verdict):
        if name not in args.ignore:
            out.append((verdict[0], label, verdict[1]))

    branches = ", ".join(args.protected)
    if stats.get("setup") is None:
        rule("push", f"Push direct sur {branches}", na("activité GitHub inaccessible"))
        rule("force", "Force-push sur une branche protégée", na("activité GitHub inaccessible"))
    else:
        pushes = rows["push"]
        code = [p for p in pushes if not p["docs"]]
        authors = {p["key"] or p["actor"]["login"] for p in pushes}
        text = f"{plural(len(pushes), 'push', 'es')} par {plural(len(authors), 'personne')}" if pushes else "aucun"
        if len(code) < len(pushes):
            text += f", dont {len(pushes) - len(code)} docs seulement"
        rule("push", f"Push direct sur {branches}", ("✗" if code else "⚠" if pushes else "✓", text))
        forced = rows["force"]
        rule("force", "Force-push sur une branche protégée", ("✗", str(len(forced))) if forced else ("✓", "aucun"))

    blocked = na("un seul élève") if n < 2 else na("aucune PR") if not regular else None

    bad = rows["revision"]
    self_merged = sum(1 for p in bad if p["merger_key"] == p["author_key"])
    text = ratio(len(bad), len(regular)) + (f", dont {self_merged} fusionnées par leur auteur" if self_merged else "")
    rule("revision", "Fusion sans revue d'un coéquipier", blocked or ("✗" if bad else "✓", text))

    with_ci = stats["with_ci"]
    rule("ci", "Fusion avec la CI rouge", (na("aucune PR") if not regular else na("aucune CI") if not with_ci else
                                           ("✗" if rows["ci"] else "✓",
                                            f"{ratio(len(rows['ci']), with_ci)} des PR avec CI")))

    reviewed = stats["reviewed"]
    rule("approve", "Revue sans le bouton Approve", blocked or (
        na("aucune PR revue") if not reviewed else
        ("⚠" if rows["approve"] else "✓", f"{ratio(len(rows['approve']), reviewed)} des PR revues")))

    big = stats["reviewed_big"]
    rule("revue", "Revue superficielle", blocked or (
        na(f"aucune PR revue de {REVIEW_MIN_LINES} lignes et plus") if not big else
        ("⚠" if rows["revue"] else "✓",
         f"{ratio(len(rows['revue']), big)} des PR revues de {REVIEW_MIN_LINES} lignes et plus")))

    approved = stats["approved"]
    rule("perimee", "Commits après la dernière approbation", blocked or (
        na("aucune PR approuvée") if not approved else
        ("⚠" if rows["perimee"] else "✓", f"{ratio(len(rows['perimee']), approved)} des PR approuvées")))

    reviewers = stats["reviewers"]
    total = sum(reviewers.values())
    if n < 3:
        conc = na("moins de 3 élèves")
    elif total < CONCENTRATION_MIN_REVIEWS:
        conc = na(f"moins de {CONCENTRATION_MIN_REVIEWS} revues")
    else:
        key, top = reviewers.most_common(1)[0]
        share = top / total
        conc = ("⚠" if share > CONCENTRATION else "✓", f"{students[key]['name']} fait {share * 100:.0f} % des revues")
    rule("concentration", "Revues concentrées sur un élève", conc)

    if not regular:
        tick = na("aucune PR")
    elif not issues:
        tick = ("⚠", "aucun ticket dans le dépôt")
    else:
        tick = ("⚠" if rows["ticket"] else "✓", f"{ratio(len(regular) - len(rows['ticket']), len(regular))}")
    rule("ticket", "PR liée à un ticket", tick)

    if regular:
        sizes = [p["lines"] for p in regular]
        out.append(("·", "Taille des PR", f"médiane {statistics.median(sizes):.0f} lignes, max {max(sizes)}"))
        if stats["reviewed"]:
            out.append(("·", "Modifiée après revue", f"{ratio(stats['iterated'], stats['reviewed'])} des PR revues"))
    protection = ", ".join(f"{b} {'oui' if v else 'non' if v is not None else '?'}"
                           for b, v in args.protection.items())
    out.append(("·", "Protection sur GitHub", protection))
    if stats["by_bot"]:
        out.append(("·", "PR ouvertes par une IA ou un bot", str(len(stats["by_bot"]))))
    return out


def colored(symbol, text, color):
    return f"\033[{COLORS[symbol]}m{text}\033[0m" if color and symbol in COLORS else text


def print_rules(rules, color):
    width = max(len(label) for _, label, _ in rules) + 2
    print(f"  {'Règle':<{width}}Constat")
    print("-" * (width + 2 + max(len(text) for _, _, text in rules)))
    for symbol, label, text in rules:
        print(colored(symbol, f"{symbol} {label:<{width}}{text}", color))


def print_students(students, color):
    cols = [("pr", "PR"), ("unreviewed", "sans revue"), ("push", "push"), ("reviews", "revues"), ("superficial", "superf.")]
    def value(s, key):
        return f"{s[key]}" + (f" ({s['force']} forcé{'s' if s['force'] > 1 else ''})" if key == "push" and s["force"] else "")

    width = max(len("Élève"), *(len(s["name"]) for s in students))
    widths = {key: max(len(label), 4, *(len(value(s, key)) for s in students)) for key, label in cols}
    print(f"{'Élève':<{width}}  " + "  ".join(f"{label:>{widths[key]}}" for key, label in cols))
    print("-" * (width + sum(w + 2 for w in widths.values())))
    for s in sorted(students, key=lambda s: (-s["pr"], -s["reviews"], s["name"])):
        cells = []
        for key, label in cols:
            cell = f"{value(s, key):>{widths[key]}}"
            if key in ("unreviewed", "push") and s[key]:
                cell = colored("✗", cell, color)
            elif key == "superficial" and s[key]:
                cell = colored("⚠", cell, color)
            cells.append(cell)
        print(f"{s['name']:<{width}}  " + "  ".join(cells))


def initials(name):
    parts = re.findall(r"[^\W\d_]+|\d+", name)
    return "".join(p[0] for p in parts[:3]).upper() if len(parts) > 1 else name[:3]


def print_matrix(students, matrix):
    people = sorted(students, key=lambda k: students[k]["name"])
    people = [k for k in people if any(matrix[(k, o)] or matrix[(o, k)] for o in people)]
    tags = {}
    for k in people:
        tag = initials(students[k]["name"])
        while tag in tags.values():
            tag += "'"
        tags[k] = tag
    labels = {k: f"{students[k]['name']} ({tags[k]})" for k in people}
    width = max(len(v) for v in labels.values())
    cell = max(4, *(len(t) for t in tags.values())) + 1
    print("\nQui relit qui (ligne = auteur de la PR, colonne = réviseur)")
    print(" " * width + "".join(f"{tags[k]:>{cell}}" for k in people))
    for a in people:
        print(f"{labels[a]:<{width}}" + "".join(
            f"{('·' if a == r else matrix[(a, r)] or '·'):>{cell}}" for r in people))


def print_timeline(series, since, until):
    """Frise d'une ou plusieurs séries de dates, comme celle de git-teamwork."""
    days = [d for _, dates in series for d in dates]
    if not days:
        return
    first = since.date() if since else min(days)
    last = (until - timedelta(seconds=1)).date() if until else max(days)
    span = (last - first).days + 1
    size = math.ceil(span / gt.TIMELINE_CELLS)
    rows = []
    for label, dates in series:
        cells = [0] * math.ceil(span / size)
        for d in dates:
            if first <= d <= last:
                cells[(d - first).days // size] += 1
        rows.append((label, cells))
    peak = max((v for _, cells in rows for v in cells), default=0)

    def level(v):
        if not v:
            return "·"
        levels = gt.TIMELINE_LEVELS
        return levels[math.ceil(len(levels) * math.log1p(v) / math.log1p(peak)) - 1]

    unit = "1 jour" if size == 1 else f"{size} jours"
    width = max(len(label) for label, _ in rows)
    print(f"\nFrise : {first} → {last}, une case = {unit}")
    for label, cells in rows:
        print(f"{label:<{width}}  " + "".join(level(v) for v in cells))


def short_time(moment):
    return moment.strftime("%Y-%m-%d %H:%M")


def duration(start, end):
    minutes = (end - start).total_seconds() / 60
    if minutes < 60:
        return f"{minutes:.0f} min"
    if minutes < 48 * 60:
        return f"{minutes / 60:.0f} h"
    return f"{minutes / 1440:.0f} j"


def print_details(students, rows, args):
    def name(key, actor=None):
        if key in students:
            return students[key]["name"]
        return (actor or {}).get("login") or "?"

    def pr_line(p, extra=""):
        merger = name(p.get("merger_key"), p["merged_by"])
        return (f"  #{p['number']:<4} {name(p['author_key'])}  {p['lines']} lignes  "
                f"fusionnée par {merger} après {duration(p['created'], p['merged'])}{extra}  {p['url']}")

    titles = {
        "push": "Push direct sur une branche protégée",
        "force": "Force-push sur une branche protégée",
        "revision": "Fusion sans revue d'un coéquipier",
        "ci": "Fusion avec la CI rouge",
        "approve": "Revue sans le bouton Approve",
        "revue": "Revue superficielle",
        "perimee": "Commits après la dernière approbation",
        "ticket": "PR sans ticket",
    }
    for rule, title in titles.items():
        if rule in args.ignore or not rows[rule]:
            continue
        print(f"\n{title} — {len(rows[rule])}")
        for item in rows[rule]:
            if rule in ("push", "force"):
                files = item["files"]
                kind = "?" if files is None else "docs" if item["docs"] else "code"
                commits = "?" if item["commits"] is None else item["commits"]
                prefix = f"{item['slug']} " if len(args.slugs) > 1 else ""
                print(f"  {short_time(item['at'])}  {prefix}{item['branch']}  {name(item['key'], item['actor'])}"
                      f"{'  force-push' if item['force'] else ''}  {commits} commit(s), {kind}  {item['subject'][:60]}")
            elif rule == "revue":
                print(pr_line(item, f", {plural(item['said'], 'mot')} de revue"))
            else:
                print(pr_line(item))


def print_identities(ids):
    by_key = collections.defaultdict(list)
    for login, key in ids.students.items():
        by_key[key].append(login)
    for key, name in sorted(ids.names.items(), key=lambda kv: kv[1]):
        logins = by_key.get(key, [])
        print(name if logins else f"{name} (aucun login GitHub)")
        for login in sorted(logins):
            print(f"  {login}")
            for contact, n in ids.contacts[login].most_common():
                print(f"    {n:5}  {contact}")
    unknown = [login for login in ids.unknown]
    if unknown:
        print("\nNon identifiés (absents du mailmap) :")
        for login in sorted(unknown, key=str.lower):
            print(f"  {login}")
            for contact, n in ids.contacts[login.lower()].most_common():
                print(f"    {n:5}  {contact}")


def main():
    parser = argparse.ArgumentParser(
        description="Pratiques d'équipe sur GitHub : pull requests, revues et pushes sur les branches protégées.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""\
Verdicts : ✗ majeur, ⚠ à corriger, ✓ respecté, · information, – sans objet.
Règles : push, force, revision, ci, approve, revue, perimee, concentration, ticket.

Identités : les logins GitHub sont reliés aux courriels de leurs commits, puis au
.mailmap, comme dans git-teamwork. Un login sans commit se déclare par son courriel
noreply : Prénom Nom <prenom@ecole.example> <12345+login@users.noreply.github.com>
Avec --mailmap, ce fichier est aussi la liste de l'équipe.

Plusieurs dépôts (ex. frontend et backend) sont analysés ensemble, comme un seul projet.

Exemples :
  gh teamwork
  gh teamwork ~/src/equipe-1 --mailmap ~/src/equipe-1.mailmap
  gh teamwork ~/src/equipe-2-front ~/src/equipe-2-back --until beta-v1 -v
  gh teamwork --ignore ticket,ci
  gh teamwork --identities""",
    )
    parser.add_argument("repos", nargs="*", default=["."], metavar="repo",
                        help="chemin d'un clone local, répétable : ils sont analysés ensemble (défaut : .)")
    parser.add_argument("-b", "--branch", action="append",
                        help="branche protégée, répétable (défaut : la branche par défaut, plus dev ou develop)")
    parser.add_argument("--since", help="date de début (AAAA-MM-JJ) ou étiquette Git")
    parser.add_argument("--until", help="date de fin, incluse (AAAA-MM-JJ), ou étiquette Git (ex. beta-v1)")
    parser.add_argument("--mailmap", help="fichier .mailmap supplémentaire, qui sert aussi de liste de l'équipe")
    parser.add_argument("--ignore", action="append", default=[], metavar="RÈGLE",
                        help="ne pas évaluer ces règles, séparées par des virgules, répétable")
    parser.add_argument("--exclude-author", action="append", default=[], metavar="REGEX",
                        help="ignorer les logins correspondants (ex. le compte du professeur), répétable")
    parser.add_argument("--exclude-file", action="append", default=[], metavar="PATTERN",
                        help="exclure aussi ces fichiers du compte de lignes des PR, répétable")
    parser.add_argument("--no-default-excludes", action="store_true",
                        help="ne pas exclure les fichiers générés connus (lock, node_modules, etc.)")
    parser.add_argument("-v", "--verbose", action="store_true",
                        help="lister les PR et les pushes en cause, avec leur lien")
    parser.add_argument("--identities", action="store_true",
                        help="lister les logins et les courriels regroupés sous chaque élève, pour écrire le .mailmap")
    args = parser.parse_args()

    args.ignore = {r.strip() for value in args.ignore for r in value.split(",") if r.strip()}
    if unknown_rules := args.ignore - set(RULES):
        sys.exit(f"Règle inconnue : {', '.join(sorted(unknown_rules))}. Règles : {', '.join(RULES)}.")

    repos = [Path(p).expanduser().resolve() for p in args.repos]
    config, roster, mailmap_files = [], None, [r / ".mailmap" for r in repos if (r / ".mailmap").is_file()]
    if args.mailmap:
        mailmap = Path(args.mailmap).expanduser().resolve()
        roster = gt.read_roster(mailmap)
        if not roster:
            sys.exit(f"Aucun élève dans {mailmap}.")
        mailmap_files.append(mailmap)
    # Un seul .mailmap combiné : chaque dépôt peut avoir le sien
    combined = tempfile.NamedTemporaryFile("w", suffix=".mailmap", delete=False)
    combined.write("\n".join(f.read_text() for f in mailmap_files))
    combined.close()
    config = [f"mailmap.file={combined.name}"]

    args.since_dt = parse_bound(args.since, repos[0], end=False)
    args.until_dt = parse_bound(args.until, repos[0], end=True)

    ids = Identities(roster, args.exclude_author)
    prs, pushes, issues, sources = [], [], 0, []
    args.slugs, args.protection, protected_all = [], {}, set()
    try:
        for repo in repos:
            owner, name = github_slug(repo)
            slug = f"{owner}/{name}"
            args.slugs.append(slug)
            info = graphql(REPO_QUERY, owner=owner, name=name)["repository"]
            default = (info["defaultBranchRef"] or {}).get("name", "main")
            issues += info["issues"]["totalCount"]
            protected = args.branch or [default] + [b for b in EXTRA_PROTECTED
                                                    if gt.ref_exists(repo, f"origin/{b}") or gt.ref_exists(repo, b)]
            protected_all.update(protected)
            for branch in protected:
                for node in graphql_nodes(HISTORY_QUERY, ["repository", "ref", "target", "history"],
                                          owner=owner, name=name, ref=f"refs/heads/{branch}"):
                    ids.add_commit(node["author"])
                key = branch if len(repos) == 1 else f"{name}:{branch}"
                args.protection[key] = read_protection(owner, name, branch)
            prs += read_prs(owner, name, args, ids)
            repo_pushes, first_day = read_pushes(repo, owner, name, protected)
            pushes = None if repo_pushes is None or pushes is None else pushes + repo_pushes
            sources.append((slug, protected, first_day))
    except GhError as e:
        sys.exit(f"Erreur gh : {e}")
    args.protected = sorted(protected_all)
    args.merge_oids = {p["merge_oid"] for p in prs if p["merge_oid"]}

    # Chaque action (PR ouverte, revue, commentaire, push) d'un compte humain
    actions = collections.Counter()
    for p in prs:
        for actor in [p["author"], *(r["author"] for r in p["reviews"]), *(c["author"] for c in p["comments"])]:
            if actor and actor.get("login") and not is_bot(actor, args.exclude_author):
                actions[actor["login"]] += 1
    for push in pushes or []:
        if push["actor"] and not is_bot(push["actor"], args.exclude_author):
            actions[push["actor"]["login"]] += 1
    logins = set(ids.contacts) | {login.lower() for login in actions}
    ids.resolve(repos[0], config, mailmap_files, logins)
    Path(combined.name).unlink()
    for login, count in actions.items():
        if login.lower() not in ids.students:
            ids.unknown[login] += count

    if args.identities:
        print_identities(ids)
        return

    students, rows, stats = analyse(prs, pushes, set(protected_all), ids, args)
    active = {k: s for k, s in students.items()
              if roster is not None or s["pr"] or s["push"] or s["reviews"]}
    n = len(active)
    color = sys.stdout.isatty()

    for slug, protected, first_day in sources:
        print(f"{slug} | branches protégées : {', '.join(protected)}"
              + (f" | depuis {first_day}" if first_day else ""))
    if args.since or args.until:
        print(f"Période : {args.since or '…'} → {args.until or '…'}")
    merged = stats["merged"]
    parts = [f"{len(stats['regular'])} fusionnées"]
    if stats["delivery"]:
        parts.append(plural(len(stats["delivery"]), "livraison"))
    if stats["by_bot"]:
        parts.append(f"{len(stats['by_bot'])} par une IA")
    if stats["by_unknown"]:
        parts.append(f"{len(stats['by_unknown'])} par des non identifiés")
    if stats["unmerged"]:
        parts.append(f"{len(stats['unmerged'])} non fusionnée{'s' if len(stats['unmerged']) > 1 else ''}")
    total_prs = len(merged) + len(stats["unmerged"])
    push_text = ("activité inaccessible" if pushes is None
                 else f"{plural(len(rows['push']), 'push', 'es')} direct{'s' if len(rows['push']) > 1 else ''}"
                 + (f" (+{stats['setup']} de mise en place)" if stats["setup"] else ""))
    print(f"{plural(n, 'élève')} | {total_prs} PR : {', '.join(parts)} | {push_text}\n")

    if ids.unknown:
        print("Non identifiés (absents du mailmap, non comptés) : "
              + ", ".join(f"{login} ({n})" for login, n in ids.unknown.most_common()))
        print()

    print_rules(evaluate(active, rows, stats, issues, n, args), color)
    print()
    print_students(list(active.values()), color)
    if n >= 3 and stats["matrix"]:
        print_matrix(active, stats["matrix"])
    print_timeline([("PR fusionnées", [p["merged"].date() for p in stats["regular"]]),
                    ("Push direct", [p["at"].date() for p in rows["push"]])],
                   args.since_dt, args.until_dt)
    if args.verbose:
        print_details(students, rows, args)


if __name__ == "__main__":
    main()
