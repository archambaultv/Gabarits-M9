class GhError(Exception):
    pass


def gh(*args):
    try:
        result = subprocess.run(["gh", *args], check=False, capture_output=True, text=True)
    except FileNotFoundError:
        sys.exit("gh est introuvable : installez GitHub CLI (https://cli.github.com) et faites « gh auth login ».")
    if result.returncode != 0:
        raise GhError(result.stderr.strip())
    return result.stdout


def graphql(query, **variables):
    args = ["api", "graphql", "-f", f"query={query}"]
    for key, value in variables.items():
        if value is not None:
            args += ["-f", f"{key}={value}"]
    return json.loads(gh(*args))["data"]


def graphql_nodes(query, path, **variables):
    """Les nœuds d'une connexion, page par page. path mène de data à la connexion."""
    cursor = None
    while True:
        conn = graphql(query, cursor=cursor, **variables)
        for key in path:
            conn = (conn or {}).get(key)
        if not conn:
            return
        yield from conn["nodes"]
        if not conn["pageInfo"]["hasNextPage"]:
            return
        cursor = conn["pageInfo"]["endCursor"]


def rest_lines(endpoint):
    """Un point d'accès REST paginé qui retourne une liste, élément par élément."""
    out = gh("api", "--paginate", endpoint, "--jq", ".[] | @json")
    return [json.loads(line) for line in out.splitlines() if line]


def run_git(repo, *args):
    """git sans quitter en cas d'erreur (objet absent après un force-push, par exemple)."""
    result = subprocess.run(["git", "-C", str(repo), "-c", "core.quotePath=false", *args],
                            check=False, capture_output=True, text=True, errors="replace")
    return result.stdout if result.returncode == 0 else None


def parse_time(value):
    """Horodatage ISO de GitHub (UTC) → heure locale."""
    return datetime.fromisoformat(value.replace("Z", "+00:00")).astimezone() if value else None


def parse_bound(value, repo, end):
    """--since / --until : une date, une date et heure, ou une étiquette Git (ex. beta-v1)."""
    if value is None:
        return None
    try:
        day = date.fromisoformat(value)
        # --until est inclusif : jusqu'à la fin de la journée
        return datetime.combine(day + timedelta(days=end), time()).astimezone()
    except ValueError:
        pass
    try:
        moment = datetime.fromisoformat(value)
        return moment.astimezone()
    except ValueError:
        pass
    out = run_git(repo, "log", "-1", "--format=%cI", value)
    if not out:
        sys.exit(f"{value} : ni une date (AAAA-MM-JJ) ni une référence Git de {repo}.")
    moment = datetime.fromisoformat(out.strip()).astimezone()
    return moment + timedelta(seconds=1) if end else moment


def github_slug(repo):
    url = run_git(repo, "remote", "get-url", "origin")
    if url is None:
        sys.exit(f"{repo} : pas un dépôt Git avec un remote origin.")
    m = GITHUB_REMOTE.search(url.strip())
    if not m:
        sys.exit(f"{repo} : origin ({url.strip()}) n'est pas un dépôt GitHub.")
    return m.group(1), m.group(2)


def words(text):
    return len((text or "").split())


def is_doc(path):
    return path.startswith(DOC_DIRS) or path.lower().endswith(DOC_SUFFIXES)


def is_bot(actor, exclude_patterns=()):
    """Un compte bot, un assistant IA, ou un compte exclu par --exclude-author."""
    if not actor:
        return False
    login = actor.get("login") or ""
    if actor.get("__typename") == "Bot" or actor.get("type") == "Bot" or login.endswith("[bot]"):
        return True
    if gt.is_ai(login, ""):
        return True
    return any(re.search(p, login, re.IGNORECASE) for p in exclude_patterns)


